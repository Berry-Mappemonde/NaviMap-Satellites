# Copernicus Data Space Ecosystem — images Sentinel (compte DISTINCT de Copernicus Marine)
# Créer un compte : https://dataspace.copernicus.eu
# Sans ces identifiants, la recherche STAC fonctionne (catalogue public).
# Ils servent au téléchargement L1C. ACOLITE refuse le L2A.
#
# Mot de passe entre quotes si vous avez un $ dedans :
# CDSE_PASSWORD='xxxx$yyyy'
#
# Déjà rempli sur le Mac (ne pas recopier ici, ne pas committer) :
#   /Users/clement/Blue-Intelligence-Map/scripts/satellite/.env
# Le CLI le lit tout seul. Sinon : NAVIMAP_CDSE_ENV=/chemin/vers/.env

CDSE_USERNAME=
CDSE_PASSWORD=

# Jeton déjà obtenu (optionnel).
# CDSE_ACCESS_TOKEN=

# ACOLITE — clone GitHub, pas un paquet pip. Un seul de ces réglages suffit.
# ACOLITE_DIR=/chemin/vers/acolite
# ACOLITE_LAUNCH=/chemin/vers/acolite/launch_acolite.py
# ACOLITE_BIN=acolite

# NASA Earthdata Login — troisième compte (ni CDSE, ni Copernicus Marine).
# Créer un compte : https://urs.earthdata.nasa.gov
# Inutile pour GIBS (fond photo) et pour la recherche CMR ATL24.
# Sert plus tard au téléchargement des granules HDF5 ICESat-2.
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=
# EARTHDATA_TOKEN=
